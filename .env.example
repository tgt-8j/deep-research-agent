# === 敏感信息模板：复制为 .env 后填入真实值 ===
# 不要将 .env 提交到 Git！

# 阿里云百炼 API Key
DASHSCOPE_API_KEY=your_api_key_here

# 博查搜索 API Key（可选）
BOCHA_API_KEY=your_bocha_key_here

# 应用环境：development / production
APP_ENV=development

# 租户 API Key 映射（JSON 格式，用于认证中间件）
# 示例：{"tenant_a": "key_a", "tenant_b": "key_b"}
TENANT_API_KEYS={}

# Redis 连接地址（可选）
REDIS_URL=redis://127.0.0.1:6379/0

# PostgreSQL 连接字符串（可选）
POSTGRES_DSN=postgresql://user:password@127.0.0.1:5432/dbname

# Milvus 向量数据库地址（可选）
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# 跨域配置（生产环境设置为具体域名，逗号分隔）
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 工作区目录
WORKSPACE_DIR=/workspace

# 是否关闭彩色输出
NO_COLOR=

# === JWT 认证配置（新增）===
# JWT 签名密钥（生产环境必须修改！）
JWT_SECRET=deep-research-jwt-secret-key-change-in-production

# Token 过期时间（分钟）
JWT_TOKEN_EXPIRE_MINUTES=60

# Agent 调用超时（秒）
CHAT_TIMEOUT_SECONDS=60
